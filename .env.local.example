# Copy this file to .env.local for local dev, and set the same values
# as Environment Variables in your Vercel project settings for production.
#
# Get these from your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Settings -> API -> "service_role" key. SECRET — never prefix this with
# NEXT_PUBLIC_, never commit it, never put it in client code. Used only by
# server actions, to power the password-gated /admin/grades view.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Whatever password you want to gate /admin/grades (real per-student grades)
# behind. Also secret — don't commit a real value.
ADMIN_PASSWORD=YOUR-ADMIN-PASSWORD
